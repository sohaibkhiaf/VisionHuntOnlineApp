<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="16dp"
        android:textDirection="rtl">

        <!-- 3D Navigation Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_3d_card_16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:text="المهام والنقاط 🏆"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_3d_main_score">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:paddingBottom="22dp">

                <!-- Top Left Circular Icon Buttons (Top End in RTL) -->
                <LinearLayout
                    android:id="@+id/layout_card_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <!-- Start Camera Circular Button -->
                    <FrameLayout
                        android:id="@+id/btn_start_camera_card"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_3d_btn_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/btn_start_camera"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="ابدأ البحث بالكاميرا"
                            android:src="@drawable/ic_vision"
                            app:tint="#166534" />

                    </FrameLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content" />

                    <!-- Gallery / Captured Images Circular Button -->
                    <FrameLayout
                        android:id="@+id/btn_gallery_card"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_3d_btn_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/btn_gallery"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="الصور المكتشفة"
                            android:src="@drawable/ic_images"
                            app:tint="#2563EB" />

                    </FrameLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content" />

                    <!-- Reset Game Circular Button -->
                    <FrameLayout
                        android:id="@+id/btn_reset_game_card"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_3d_btn_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/btn_reset_game"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="إعادة بدء اللعبة"
                            android:src="@drawable/ic_restart"
                            app:tint="#B91C1C" />

                    </FrameLayout>

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content" />

                    <!-- Profile & Rules Circular Button -->
                    <FrameLayout
                        android:id="@+id/btn_profile_info_card"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_3d_btn_circle"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/btn_profile_info"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="معلومات الحساب وقواعد اللعبة"
                            android:src="@drawable/ic_info"
                            app:tint="#D97706" />

                    </FrameLayout>

                </LinearLayout>

                <!-- Mini Leaderboard Box (Under Circular Buttons) -->
                <FrameLayout
                    android:id="@+id/card_mini_leaderboard"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/layout_card_actions"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layout_mini_leaderboard_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_3d_card"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingBottom="5dp"
                        android:paddingTop="5dp" />

                </FrameLayout>

                <!-- Score Label & Score -->
                <TextView
                    android:id="@+id/tv_score_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:text="⭐ مجموع النقاط"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_score_label"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <!-- Completed Tasks text directly UNDER score -->
                <TextView
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_score"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="2dp"
                    android:text="المهام المكتملة: 0/80"
                    android:textColor="#DCFCE7"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/divider_card"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@id/tv_progress"
                    android:layout_marginTop="10dp"
                    android:background="#40FFFFFF" />

                <!-- Current Event Box -->
                <LinearLayout
                    android:id="@+id/layout_current_event"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/divider_card"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tv_event_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ℹ️ لا يوجد حدث جارٍ حالياً"
                        android:textColor="#FEF08A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_event_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="تابعنا لمعرفة التحديات والفعاليات القادمة!"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />

                </LinearLayout>

            </RelativeLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/tv_tasks_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="قائمة التحديات"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- RecyclerView for Tasks List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_tasks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <!-- Container for Ended Event Table -->
        <LinearLayout
            android:id="@+id/layout_ended_table_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
