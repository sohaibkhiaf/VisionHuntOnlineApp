<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="16dp"
    android:textDirection="rtl">

    <!-- Brand & Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="VISION HUNT"
        android:textColor="#16A34A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="2dp"
        android:text="المهام والنقاط"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Score Summary Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#166534"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Top Left Circular Icon Buttons (Top End in RTL) -->
            <LinearLayout
                android:id="@+id/layout_card_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <!-- Start Camera Circular Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_start_camera_card"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_start_camera"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="ابدأ البحث بالكاميرا"
                        android:src="@drawable/ic_vision"
                        app:tint="#166534" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <!-- Gallery / Captured Images Circular Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_gallery_card"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_gallery"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="الصور المكتشفة"
                        android:src="@drawable/ic_images"
                        app:tint="#2563EB" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <!-- Reset Game Circular Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_reset_game_card"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_reset_game"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="إعادة بدء اللعبة"
                        android:src="@drawable/ic_restart"
                        app:tint="#B91C1C" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <!-- Profile & Rules Circular Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_profile_info_card"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_profile_info"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="معلومات الحساب وقواعد اللعبة"
                        android:src="@drawable/ic_info"
                        app:tint="#D97706" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Score Label & Score -->
            <TextView
                android:id="@+id/tv_score_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:text="مجموع النقاط"
                android:textColor="#DCFCE7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_score_label"
                android:layout_alignParentStart="true"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/divider_card"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/tv_score"
                android:layout_marginTop="8dp"
                android:background="#40FFFFFF" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/divider_card"
                android:layout_alignParentStart="true"
                android:layout_marginTop="8dp"
                android:text="المهام المكتملة: 0/80"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:text="قائمة التحديات"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- RecyclerView for Tasks List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
