<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="16dp"
    android:textDirection="rtl">

    <!-- Brand & Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="VISION HUNT"
        android:textColor="#16A34A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="2dp"
        android:text="المهام والنقاط"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Score Summary Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#166534"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Top Left Circular Icon Buttons (Top End in RTL) -->
            <LinearLayout
                android:id="@+id/layout_card_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <!-- Start Camera Circular Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_start_camera_card"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_start_camera"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="ابدأ البحث بالكاميرا"
                        android:src="@drawable/ic_vision"
                        app:tint="#166534" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <!-- Gallery / Captured Images Circular Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_gallery_card"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_gallery"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="الصور المكتشفة"
                        android:src="@drawable/ic_images"
                        app:tint="#2563EB" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <!-- Reset Game Circular Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_reset_game_card"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_reset_game"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="إعادة بدء اللعبة"
                        android:src="@drawable/ic_restart"
                        app:tint="#B91C1C" />

                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <!-- Profile & Rules Circular Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_profile_info_card"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/btn_profile_info"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="معلومات الحساب وقواعد اللعبة"
                        android:src="@drawable/ic_info"
                        app:tint="#D97706" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Mini Leaderboard Box (Under Circular Buttons) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mini_leaderboard"
                android:layout_width="168dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/layout_card_actions"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="#25000000"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#30FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/layout_mini_leaderboard_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="5dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Score Label & Score -->
            <TextView
                android:id="@+id/tv_score_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:text="مجموع النقاط"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_score_label"
                android:layout_alignParentStart="true"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Completed Tasks text directly UNDER score -->
            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_score"
                android:layout_alignParentStart="true"
                android:layout_marginTop="2dp"
                android:text="المهام المكتملة: 0/80"
                android:textColor="#DCFCE7"
                android:textSize="13sp" />

            <View
                android:id="@+id/divider_card"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@id/tv_progress"
                android:layout_marginTop="10dp"
                android:background="#40FFFFFF" />

            <!-- Current Event Box -->
            <LinearLayout
                android:id="@+id/layout_current_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/divider_card"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_event_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ لا يوجد حدث جارٍ حالياً"
                    android:textColor="#FEF08A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_event_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="تابعنا لمعرفة التحديات والفعاليات القادمة!"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

            </LinearLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_tasks_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:text="قائمة التحديات"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- RecyclerView for Tasks List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <!-- Container for Ended Event Table -->
    <LinearLayout
        android:id="@+id/layout_ended_table_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
