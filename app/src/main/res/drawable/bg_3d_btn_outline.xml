<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <corners android:radius="16dp" />
                    <solid android:color="@color/btn_outline_bg" />
                    <stroke android:width="1.5dp" android:color="@color/btn_outline_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <corners android:radius="16dp" />
                    <solid android:color="@color/btn_outline_shadow" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape>
                    <corners android:radius="16dp" />
                    <solid android:color="@color/task_completed_bg" />
                    <stroke android:width="1.5dp" android:color="@color/task_completed_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <corners android:radius="16dp" />
                    <solid android:color="@color/btn_outline_shadow" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape>
                    <corners android:radius="16dp" />
                    <solid android:color="@color/btn_outline_bg" />
                    <stroke android:width="1.5dp" android:color="@color/btn_outline_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>